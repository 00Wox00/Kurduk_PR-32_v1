<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Верхняя белая часть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Логотип вверху слева -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="78dp"
            android:layout_height="70dp"
            android:src="@drawable/contract"
            android:scaleType="fitCenter" />

        <!-- Чёрная линия под логотипом -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#000000" />

        <!-- Заголовок Регистрация -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Регистрация"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#83D96E"
            android:gravity="center" />

    </LinearLayout>

    <!-- Нижняя зелёная часть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:background="#83D96E"
        android:paddingStart="55dp"
        android:paddingEnd="55dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- Текст подсказка -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Введите ваш логин и пароль"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <!-- Логин -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Логин"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/etLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:background="@drawable/edit_text_line"
            android:layout_marginBottom="30dp" />

        <!-- Пароль -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пароль"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:background="@drawable/edit_text_line"
            android:layout_marginBottom="30dp" />

        <!-- Пустое место чтобы кнопка была внизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Кнопка ВОЙТИ -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="ВОЙТИ"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button" />

    </LinearLayout>

</LinearLayout>